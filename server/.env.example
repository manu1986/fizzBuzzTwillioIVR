# Copy to .env and fill in. The skeleton runs WITHOUT keys (graceful degradation):
#  - no ANTHROPIC_API_KEY -> extraction falls back to a heuristic (title/description)
#  - no VOYAGE_API_KEY    -> embeddings fall back to a deterministic hash vector
# Set the keys to get real extraction + semantic search.

PORT=3000
DATABASE_URL=postgres://curio:curio@localhost:5432/curio

ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

DEFAULT_USER_ID=dev-user

# Auth & limits. Leave AUTH_REQUIRED unset for local dev (requests run as
# DEFAULT_USER_ID). Set to true in any shared/prod environment, then mint a key:
#   node src/cli.js mintkey <userId>   ->   send as: Authorization: Bearer <key>
AUTH_REQUIRED=false
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Optional: real geocoder (else OpenStreetMap Nominatim dev fallback)
GOOGLE_PLACES_API_KEY=
DEFAULT_TIMEZONE=UTC

# Stealth headless-browser fallback for login/bot-walled pages (Instagram/YouTube).
# Requires: npm i playwright-extra puppeteer-extra-plugin-stealth playwright
#           npx playwright install chromium
# BROWSER_PROXY ideally points at a residential proxy (the real anti-block lever).
BROWSER_FALLBACK=false
BROWSER_PROXY=
BROWSER_TIMEOUT_MS=20000
